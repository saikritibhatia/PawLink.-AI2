# The ONLY variable you set by hand.
# Get it at console.anthropic.com, then paste it into Vercel:
# Settings -> Environment Variables.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Turns "Halston Park" into a real distance in miles.
# Uses OpenStreetMap, which is free but asks for a contact address.
ENABLE_GEOCODING=true
GEOCODER_CONTACT=you@example.com

# Vercel injects these two on its own when you create the stores in the
# Storage tab. Do not set them yourself, and do not commit them.
#   DATABASE_URL           <- from the Neon Postgres store
#   BLOB_READ_WRITE_TOKEN  <- from the Blob store
